<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- A 3PCC extended master: a command to s1, which never runs, as the
     master's own -slave_cfg host is refused. -->
<scenario name="3pcc extended master">
  <sendCmd dest="s1">
    <![CDATA[
      Call-ID: [call_id]
      From: m
    ]]>
  </sendCmd>
</scenario>
