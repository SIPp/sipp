#!/bin/sh
# This regression test is a part of SIPp.
# AKAv1-MD5 with aka_K but no aka_OP or aka_AMF takes those as zeros,
# rather than whatever the buffers held, and gives the right response.
. "`dirname "$0"`/../functions"; init

sippfg -sf uas.xml -i 127.0.0.1 -p 5070 -m 1 -timeout 8 -timeout_error \
    >/dev/null 2>&1 &
uas=$!
sleep 1
sippfg -sf uac.xml -i 127.0.0.1 -p 5071 -m 1 127.0.0.1:5070 \
    -timeout 6 -timeout_error >/dev/null 2>&1
uac_status=$?
wait $uas
uas_status=$?

if test $uac_status -ne 0; then
    fail "UAC failed with $uac_status"
elif test $uas_status -ne 0; then
    fail "UAS failed with $uas_status: the response was not the expected one"
else
    ok
fi
