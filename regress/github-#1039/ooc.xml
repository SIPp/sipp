<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- An out-of-call OPTIONS, answered after a timed pause. -->
<scenario name="ooc rtd">
  <recv request="OPTIONS" />
  <nop start_rtd="ooc" />
  <pause milliseconds="10" />
  <nop rtd="ooc" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
</scenario>
