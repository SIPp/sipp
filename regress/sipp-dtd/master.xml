<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- A master that sends its slave two commands. -->
<scenario name="sipp.dtd master">
  <sendCmd dest="s1">
    <![CDATA[
      Call-ID: [call_id]
      From: m
    ]]>
  </sendCmd>
  <sendCmd dest="s1">
    <![CDATA[
      Call-ID: [call_id]
      From: m
    ]]>
  </sendCmd>
  <recvCmd src="s1"/>
</scenario>
