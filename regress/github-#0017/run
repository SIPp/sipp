#!/bin/sh
# This regression test is a part of SIPp.
# A '[' not closed before the next keyword is a load error, rather than
# text moved behind that keyword (or a keyword buffer overflow).
. "`dirname "$0"`/../functions"; init

out=`sippfg -sf uac.xml -i 127.0.0.1 -p 25500 -m 1 127.0.0.1:25501 \
    -timeout 2 2>&1`
status=$?

if test $status -ne 255; then
    fail "exit status $status, not 255"
elif ! echo "$out" | grep -q 'Syntax error or invalid \[keyword\]'; then
    fail "no syntax error"
else
    ok
fi
