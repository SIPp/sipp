<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- Challenges with an opaque of 2100 characters (from -key) and a qop
     list whose auth is past its 15th character, and accepts only
     credentials that return the opaque whole, with qop=auth. -->
<scenario name="long opaque uas">
  <recv request="REGISTER"/>
  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=srv
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="r", nonce="n0", qop="token-one,token-two,auth", algorithm=MD5, opaque="[opaque]"
      Content-Length: 0
    ]]>
  </send>
  <recv request="REGISTER">
    <action>
      <ereg regexp=",opaque=&quot;(o{100}){21}&quot;" search_in="msg" check_it="true" assign_to="_"/>
      <ereg regexp=",qop=auth," search_in="msg" check_it="true" assign_to="_"/>
      <verifyauth assign_to="authvalid" username="alice" password="secret"/>
    </action>
  </recv>
  <nop test="authvalid" next="good"/>
  <send next="end">
    <![CDATA[
      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=srv
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <label id="good"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=srv
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <label id="end"/>
</scenario>
