#!/bin/sh
# This regression test is a part of SIPp.
# An ereg can assign its match to the variable it searches: the
# submatches after it are still taken from the value searched, not
# from the freed one.
. "`dirname "$0"`/../functions"; init

sippfg -sf uac.xml -i 127.0.0.1 -p 25861 -m 1 127.0.0.1:25860 \
    -timeout 2 -trace_err >/dev/null 2>&1
status=$?

if test $status -ne 0; then
    fail "exit status $status: `cat uac_*_errors.log 2>/dev/null`"
else
    ok
fi
