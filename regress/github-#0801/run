#!/bin/sh
# This regression test is a part of SIPp.
# <recv timeout_variable> reads the receive timeout of each call from a
# call variable, here a CSV field, rather than from the scenario.
. "`dirname "$0"`/../functions"; init

printf 'SEQUENTIAL\n200;\n1500;\n' >timeouts.csv
sed -e 's/timeout_variable=/timeout="100" &/' uac.xml >both.xml
start=`date +%s%N`
sippfg -sf uac.xml -inf timeouts.csv -m 2 -l 1 -nr -i 127.0.0.1 -p 25900 \
    127.0.0.1:25901 -timeout 8 -timeout_error >/dev/null 2>&1
status=$?
elapsed=$(( (`date +%s%N` - start) / 1000000 ))
sippfg -sf both.xml -inf timeouts.csv -m 1 -i 127.0.0.1 -p 25900 \
    127.0.0.1:25901 >/dev/null 2>&1
both=$?
rm -f timeouts.csv both.xml

if test $status -ne 0; then
    fail "UAC failed with $status"
elif test $elapsed -lt 1700 -o $elapsed -gt 5000; then
    fail "the calls took ${elapsed}ms, not about 1700ms"
elif test $both -ne 255; then
    fail "timeout with timeout_variable exited with $both"
else
    ok
fi
